# Copy sang `.env` và điền giá trị thật. KHÔNG commit file .env.

# --- App ---
ENVIRONMENT=local
LOG_LEVEL=INFO

GCP_PROJECT_ID=nexlab-poc

# --- OCR cho CV dạng ảnh scan (Vertex AI, không dùng API key) ---
OCR_ENABLED=true
GEMINI_MODEL=gemini-2.5-flash
VERTEX_LOCATION=global
OCR_TIMEOUT_SECONDS=180

# --- Notion ---
# Internal integration token; nhớ share database đích cho integration đó.
NOTION_API_KEY=
# Data source id, lấy bằng:
#   uv run python -m scripts.inspect_notion --database-id <URL bảng>
# Nhiều bảng thì ngăn cách bằng dấu phẩy — luồng xử lý chạy song song trên tất cả.
NOTION_SOURCE_DATA_SOURCE_IDS=f3670df0-38d4-450e-bd2d-3d0a96ae8432,3352c7d6-a903-8126-941c-000be5bb1aef
SCAN_CONCURRENCY=3

# --- Trang quản trị cho HR ---
# Mật khẩu dùng chung; rỗng = KHÔNG chặn (chỉ chấp nhận được khi chạy local).
ADMIN_PASSWORD=
# Tên Cloud Run Job mà nút bấm sẽ kích hoạt.
CLOUD_RUN_JOB_NAME=nexlab-recruit-dev-scan-job
CLOUD_SCHEDULER_JOB_NAME=nexlab-recruit-dev-daily-scan
GCP_REGION=asia-southeast1

# --- Tải file CV ---
DOWNLOAD_TIMEOUT_SECONDS=60
MAX_CV_BYTES=20971520
