# Copy sang `.env` và điền giá trị thật. KHÔNG commit file .env.

# --- App ---
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Gemini qua Vertex AI (KHÔNG dùng API key) ---
# Xác thực bằng Application Default Credentials:
#   local:      gcloud auth application-default login
#   Cloud Run:  service account gắn vào service (role roles/aiplatform.user)
# Để trống GCP_PROJECT_ID thì SDK tự lấy từ ADC.
GCP_PROJECT_ID=nexlab-poc
VERTEX_LOCATION=global
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=120

# --- Notion ---
# Internal integration token; nhớ share database đích cho integration đó.
NOTION_API_KEY=
# Data source id, lấy bằng:
#   uv run python -m scripts.inspect_notion --database-id <URL bảng>
NOTION_SOURCE_DATA_SOURCE_ID=f3670df0-38d4-450e-bd2d-3d0a96ae8432
NOTION_TARGET_DATA_SOURCE_ID=d78bf4b2-d709-42f2-bfdb-6efe1d06d0fa
SCAN_CONCURRENCY=4

# --- Trang quản trị cho HR ---
# Mật khẩu dùng chung; rỗng = KHÔNG chặn (chỉ chấp nhận được khi chạy local).
ADMIN_PASSWORD=
# Tên Cloud Run Job mà nút bấm sẽ kích hoạt.
CLOUD_RUN_JOB_NAME=nexlab-recruit-dev-scan-job
GCP_REGION=asia-southeast1

# --- Tải file CV ---
DOWNLOAD_TIMEOUT_SECONDS=60
MAX_CV_BYTES=20971520
