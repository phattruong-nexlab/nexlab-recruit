# Copy sang `.env` và điền giá trị thật. KHÔNG commit file .env.

# --- App ---
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- MCP ---
MCP_PATH=/mcp
# Bearer token agent phải gửi kèm: Authorization: Bearer <token>
# Sinh bằng: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_AUTH_TOKEN=

# --- Gemini qua Vertex AI (KHÔNG dùng API key) ---
# Xác thực bằng Application Default Credentials:
#   local:      gcloud auth application-default login
#   Cloud Run:  service account gắn vào service (role roles/aiplatform.user)
# Để trống GCP_PROJECT_ID thì SDK tự lấy từ ADC.
GCP_PROJECT_ID=nexlab-poc
VERTEX_LOCATION=global
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=120

# --- Notion ---
# Internal integration token; nhớ share database đích cho integration đó.
NOTION_API_KEY=
# Data source id của bảng ĐÍCH (nơi ghi kết quả), lấy bằng:
#   uv run python -m scripts.inspect_notion --database-id <URL bảng đích>
NOTION_TARGET_DATA_SOURCE_ID=

# --- Tải file CV ---
DOWNLOAD_TIMEOUT_SECONDS=60
MAX_CV_BYTES=20971520
